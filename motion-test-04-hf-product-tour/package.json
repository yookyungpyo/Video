{
  "name": "motion-test-04-hf-product-tour",
  "version": "1.0.0",
  "private": true,
  "description": "HF Financial Product Tour — 20s product tour built from HF mobile app screenshots (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
