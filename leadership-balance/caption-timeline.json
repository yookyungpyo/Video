   "voiceEnd": 4.17,
   "narration": [
    {
     "start": 0.27,
     "text": "리더는"
    },
    {
     "start": 0.83,
     "text": "조직 중심이어야 할까?"
    },
    {
     "start": 2.7,
     "text": "사람 중심이어야 할까?"
    }
   ]
  },
  {
   "scene": 2,
   "start": 4.6,
   "end": 9.33,
   "voiceEnd": 8.87,
   "narration": [
    {
     "start": 4.87,
     "text": "조직의 성과를 생각하면,"
    },
    {
     "start": 6.7,
     "text": "때로는 냉정한 결정을"
    },
    {
     "start": 8.03,
     "text": "내려야 한다."
    }
   ]
  },
  {
   "scene": 3,
   "start": 9.33,
   "end": 13.77,
   "voiceEnd": 13.3,
   "narration": [
    {
     "start": 9.6,
     "text": "하지만 그 결정이,"
    },
    {
     "start": 11.2,
     "text": "누군가에게는 상처가"
    },
    {
     "start": 13.13,
     "text": "될 수도 있다."
    }
   ]
  },
  {
   "scene": 4,
   "start": 13.77,
   "end": 20.17,
   "voiceEnd": 19.7,
   "narration": [
    {
     "start": 14.03,
     "text": "그렇다고 사람만 생각하다 보면,"
    },
    {
     "start": 16.3,
     "text": "조직이 지켜야 할 원칙과 목표가,"
    },
    {
     "start": 18.73,
     "text": "흔들릴 수도 있다."
    }
   ]
  },
  {
   "scene": 5,
   "start": 20.17,
   "end": 27.17,
   "voiceEnd": 26.47,
   "narration": [
    {
     "start": 20.43,
     "text": "그래서 늘 어렵다."
    },
    {
     "start": 22.7,
     "text": "어디까지 이해해야 하고,"
    },
    {
     "start": 24.5,
     "text": "어디서부터 원칙을 지켜야 할까."
    }
   ]
  },
  {
   "scene": 6,
   "start": 27.17,
   "end": 31.63,
   "voiceEnd": 31.17,
   "narration": [
    {
     "start": 27.43,
     "text": "어쩌면 리더십에는,"
    },
    {
     "start": 29.13,
     "text": "정해진 중심이 없는지도 모른다."
    }
   ]
  },
  {
   "scene": 7,
   "start": 31.63,
   "end": 38.93,
   "voiceEnd": 38.5,
   "narration": [
    {
     "start": 31.9,
     "text": "어떤 순간에는 조직을 위해 단호해야 하고,"
    },
    {
     "start": 35.13,
     "text": "어떤 순간에는 사람을 위해 한 걸음 물러서야 한다."
    }
   ]
  },
  {
   "scene": 8,
   "start": 38.93,
   "end": 45.93,
   "voiceEnd": 45.5,
   "narration": [
    {
     "start": 39.23,
     "text": "중요한 건,"
    },
    {
     "start": 40.17,
     "text": "어느 한쪽을 선택하는 게 아니라,"
    },
    {
     "start": 42.3,
     "text": "그때마다 무엇이 더 중요한지,"
    },
    {
     "start": 44.57,
     "text": "판단하는 일이다."
    }
   ]
  },
  {
   "scene": 9,
   "start": 45.93,
   "end": 58.33,
   "voiceEnd": 55.93,
   "narration": [
    {
     "start": 46.23,
     "text": "리더는 조직과 사람 사이,"
    },
    {
     "start": 48.53,
     "text": "그 중간 어디쯤에서,"
    },
    {
     "start": 50.13,
     "text": "끊임없이 균형을 찾아가는 사람이다."
    },
    {
     "start": 52.8,
     "text": "그 균형에는 정답이 없기에,"
    },
    {
     "start": 55,
     "text": "늘 어렵다."
    }
   ]
  }
 ],
