{
  "take": "assets/narration/full-take.mp3",
  "scenes": {
    "scene-01": {
      "duration": 3.26,
      "lines": [
        {
          "start": 0.0,
          "end": 0.96,
          "text": "리더가 되면,"
        },
        {
          "start": 1.1,
          "end": 3.22,
          "text": "일하는 방식부터 달라져야 합니다."
        }
      ]
    },
    "scene-02": {
      "duration": 3.52,
      "lines": [
        {
          "start": 0.04,
          "end": 1.42,
          "text": "내가 잘하는 사람에서"
        },
        {
          "start": 1.7,
          "end": 3.48,
          "text": "팀이 잘하게 만드는 사람으로."
        }
      ]
    },
    "scene-03": {
      "duration": 4.01,
      "lines": [
        {
          "start": 0.04,
          "end": 1.99,
          "text": "먼저, 팀이 어디로 가는지"
        },
        {
          "start": 2.21,
          "end": 3.97,
          "text": "방향을 다시 분명히 합니다."
        }
      ]
    },
    "scene-04": {
      "duration": 3.61,
      "lines": [
        {
          "start": 0.04,
          "end": 1.721,
          "text": "그리고 한 사람 한 사람을"
        },
        {
          "start": 1.721,
          "end": 3.57,
          "text": "이해하는 데 시간을 씁니다."
        }
      ]
    },
    "scene-05": {
      "duration": 3.1,
      "lines": [
        {
          "start": 0.04,
          "end": 1.69,
          "text": "각자의 강점이 살아나도록"
        },
        {
          "start": 1.89,
          "end": 3.06,
          "text": "역할을 배치합니다."
        }
      ]
    },
    "scene-06": {
      "duration": 3.64,
      "lines": [
        {
          "start": 0.04,
          "end": 1.98,
          "text": "막힌 곳에서는 답을 주기보다"
        },
        {
          "start": 2.16,
          "end": 3.6,
          "text": "함께 문제를 풉니다."
        }
      ]
    },
    "scene-07": {
      "duration": 3.87,
      "lines": [
        {
          "start": 0.04,
          "end": 1.75,
          "text": "스스로 해낸 경험이 쌓이도록"
        },
        {
          "start": 1.98,
          "end": 3.83,
          "text": "성장을 끝까지 지원합니다."
        }
      ]
    },
    "scene-08": {
      "duration": 3.07,
      "lines": [
        {
          "start": 0.04,
          "end": 1.07,
          "text": "리더의 성과는,"
        },
        {
          "start": 1.21,
          "end": 3.03,
          "text": "팀의 성장으로 증명됩니다."
        }
      ]
    }
  }
}