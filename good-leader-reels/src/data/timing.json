   "to": 836,
   "voice": true,
   "voiceEnd": 824,
   "chunks": [
    {
     "start": 672,
     "end": 773,
     "text": "그 순간 한 사람과의 관계는\n지켰을지 몰라도,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 60,
     "lines": 2
    },
    {
     "start": 773,
     "end": 836,
     "text": "{팀의 기준은 무너집니다.}",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 60,
     "lines": 1
    }
   ]
  },
  {
   "n": 6,
   "from": 836,
   "to": 1066,
   "voice": true,
   "voiceEnd": 1042,
   "chunks": [
    {
     "start": 845,
     "end": 898,
     "text": "싫은 소리를 하지 않는 건,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 60,
     "lines": 1
    },
    {
     "start": 898,
     "end": 956,
     "text": "{배려가 아닐 수 있습니다.}",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 60,
     "lines": 1
    },
    {
     "start": 956,
     "end": 975,
     "text": "그저,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 60,
     "lines": 1
    },
    {
     "start": 975,
     "end": 1066,
     "text": "{내가 미움받기 싫은 것}일 수도 있습니다.",
