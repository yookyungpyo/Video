    {
     "start": 9,
     "end": 94,
     "text": "모든 사람에게\n{좋은 사람}으로 남으면서,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 60,
     "lines": 2
    },
    {
     "start": 94,
     "end": 159,
     "text": "{좋은 리더}가 될 수 있을까요?",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 60,
     "lines": 1
    }
   ]
  },
  {
   "n": 2,
