   "to": 372,
   "voice": true,
   "voiceEnd": 360,
   "chunks": [
    {
     "start": 158,
     "end": 251,
     "text": "나는 {편안함}을\n오래 즐기지 않는다.",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 2
    },
    {
     "start": 251,
     "end": 288,
     "text": "편해지는 순간,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 288,
     "end": 372,
     "text": "나도 모르게\n{안주}하기 시작하기 때문이다.",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 2
    }
   ]
  },
  {
   "n": 3,
