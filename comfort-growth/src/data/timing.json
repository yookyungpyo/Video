   "to": 850,
   "voice": true,
   "voiceEnd": 839,
   "chunks": [
    {
     "start": 614,
     "end": 710,
     "text": "그런데 그때부터\n{착각}이 시작된다.",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 2
    },
    {
     "start": 710,
     "end": 758,
     "text": "내가 많이 성장해서,",
