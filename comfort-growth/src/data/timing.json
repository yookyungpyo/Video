   "to": 605,
   "voice": true,
   "voiceEnd": 593,
   "chunks": [
    {
     "start": 381,
     "end": 436,
     "text": "처음에는 어렵던 일도,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 436,
     "end": 502,
     "text": "반복하다 보면 {쉬워진다.}",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 502,
     "end": 529,
     "text": "어느 순간,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 529,
     "end": 605,
     "text": "고민하지 않아도\n잘할 수 있게 된다.",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 2
    }
