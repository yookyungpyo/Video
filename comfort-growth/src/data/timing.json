     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 758,
     "end": 850,
     "text": "이제는 뭐든\n잘할 수 있을 것 같은 {착각.}",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 2
    }
   ]
  },
  {
