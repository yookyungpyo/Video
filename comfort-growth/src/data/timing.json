     "start": 9,
     "end": 70,
     "text": "나는 왜 일이 {편해질} 때마다,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 70,
     "end": 148,
     "text": "스스로 {불편한 상황}을 만들까?",
