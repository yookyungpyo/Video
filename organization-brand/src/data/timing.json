    {
     "start": 7,
     "end": 91,
     "text": "당신의 조직에는 {브랜드}가 있는가?",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 91,
     "end": 126,
     "text": "회사의 로고나 슬로건을",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 126,
     "end": 186,
     "text": "이야기하는 것이 아니다.",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    }
   ]
  },
  {
   "n": 2,
   "from": 186,
   "to": 467,
   "voice": true,
   "voiceEnd": 457,
   "chunks": [
    {
     "start": 193,
     "end": 265,
     "text": "조직도 하나의 {브랜드}다.",
