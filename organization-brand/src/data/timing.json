   "to": 674,
   "voice": true,
   "voiceEnd": 664,
   "chunks": [
    {
     "start": 474,
     "end": 518,
     "text": "누구를 만나더라도,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 518,
     "end": 610,
     "text": "고객이 {같은 가치}를\n경험할 수 있어야 한다.",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 2
    },
    {
     "start": 610,
     "end": 674,
     "text": "그것이 조직의 {브랜딩}이다.",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    }
   ]
  },
  {
