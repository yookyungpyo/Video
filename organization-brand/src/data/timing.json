     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 2
    },
    {
     "start": 773,
     "end": 808,
     "text": "우리 조직에는,",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 808,
     "end": 869,
     "text": "명확한 {목표점}이 있는가?",
