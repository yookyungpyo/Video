     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    },
    {
     "start": 401,
     "end": 467,
     "text": "그것이 조직의 {브랜딩}이다.",
     "quote": false,
     "rhythm": false,
     "center": false,
     "fontSize": 54,
     "lines": 1
    }
   ]
  },
  {
   "n": 3,
