{
  "name": "3d-website-flythrough",
  "version": "1.0.0",
  "private": true,
  "description": "15s 3D page flythrough motion piece \u2014 Remotion + React Three Fiber",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "preview": "remotion studio src/index.ts --port 3000",
    "render": "remotion render src/index.ts Flythrough output/flythrough.mp4 --codec=h264 --crf=16 --gl=angle",
    "render:cpu": "remotion render src/index.ts Flythrough output/flythrough.mp4 --codec=h264 --crf=16 --gl=swangle",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit",
    "render:hf": "remotion render src/index.ts FlythroughHF output/flythrough-hf.mp4 --codec=h264 --crf=16 --gl=angle",
    "render:hf:cpu": "remotion render src/index.ts FlythroughHF output/flythrough-hf.mp4 --codec=h264 --crf=16 --gl=swangle"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "^4.0.441",
    "@remotion/three": "^4.0.441",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.441",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3"
  }
}
